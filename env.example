# --- Site ---
SITE_URL=https://your-project.vercel.app
SESSION_SECRET=long_random_string_here_at_least_32_chars

# --- Discord sign-in (discord.com/developers > your app > OAuth2) ---
# Add redirect: https://your-project.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Google sign-in (console.cloud.google.com > APIs & Services > Credentials) ---
# Add redirect: https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (connect Vercel Postgres to the project; sets POSTGRES_URL automatically) ---
# Copy the same URL into the bot's .env as DATABASE_URL

# --- Discord alerts for staff (channel settings > Integrations > Webhooks) ---
DISCORD_WEBHOOK_URL=

# --- AI chat (openrouter.ai) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/auto
